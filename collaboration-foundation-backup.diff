+export async function updateRecommendationStatus(input:unknown){return safe(async()=>{const data=z.object({id:uuid,status:z.enum(["OPEN","SAVED","REVIEWING","ACCEPTED","DISMISSED"])}).parse(input);const context=await requireWorkspaceContext();requirePermission(context.membership.role,"recommendation.decide");const changed=await database().update(recommendations).set({status:data.status,updatedAt:new Date()}).where(and(eq(recommendations.id,data.id),eq(recommendations.organizationId,context.organization.id))).returning({id:recommendations.id});if(!changed[0])throw new Error("Resource not found");await appendAuditLog({organizationId:context.organization.id,actorId:context.user.id,action:"recommendation.status_changed",entityType:"recommendation",entityId:data.id,metadata:{status:data.status}});if(data.status==="ACCEPTED"||data.status==="DISMISSED")await collaborationRepository(context).activity.append(deterministicActivity(data.status==="ACCEPTED"?"recommendation.accepted":"recommendation.rejected","recommendation",data.id));revalidatePath("/workspace/recommendations")})}
