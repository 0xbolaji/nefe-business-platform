-export async function updatePilotExecution(input:unknown){return safe(async()=>{const data=z.discriminatedUnion("kind",[z.object({kind:z.literal("milestone"),id:uuid,status:z.enum(["NOT_STARTED","IN_PROGRESS","BLOCKED","COMPLETE"])}),z.object({kind:z.literal("task"),id:uuid,status:z.enum(["NOT_STARTED","IN_PROGRESS","BLOCKED","COMPLETE"])}),z.object({kind:z.literal("approval"),id:uuid,status:z.enum(["NOT_REQUESTED","PENDING","APPROVED","CHANGES_REQUESTED","DECLINED"])}),z.object({kind:z.literal("risk"),id:uuid,status:z.enum(["OPEN","MITIGATING","ACCEPTED","CLOSED"])})]).parse(input);const context=await requireWorkspaceContext();const permission=data.kind==="approval"?"pilot.approve":data.kind==="risk"?"risk.update":"pilot.create";requirePermission(context.membership.role,permission);const table=data.kind==="milestone"?pilotMilestones:data.kind==="task"?pilotTasks:data.kind==="approval"?pilotApprovals:pilotRisks;const changed=await database().update(table).set({status:data.status,updatedAt:new Date()}).where(and(eq(table.id,data.id),eq(table.organizationId,context.organization.id))).returning({id:table.id});if(!changed[0])throw new Error("Resource not found");await appendAuditLog({organizationId:context.organization.id,actorId:context.user.id,action:`pilot.${data.kind}_changed`,entityType:data.kind,entityId:data.id,metadata:{status:data.status}});revalidatePath("/workspace/pilots")})}
