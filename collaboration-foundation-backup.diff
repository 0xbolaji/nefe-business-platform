 export type MutationResult={ok:true}|{ok:false;error:string};const uuid=z.string().uuid();const safe=async(action:()=>Promise<void>):Promise<MutationResult>=>{try{await action();return {ok:true}}catch(error){if(error instanceof z.ZodError)return {ok:false,error:"Review the submitted values."};if(error instanceof Error&&error.name==="AuthorizationError")return {ok:false,error:error.message};return {ok:false,error:"The change could not be saved."}}};
 export async function toggleFavorite(input:unknown){return safe(async()=>{const data=z.object({entityType:z.enum(["business","opportunity","campaign","journey","pilot"]),entityId:z.string().min(1).max(100)}).parse(input);const context=await requireWorkspaceContext();const db=database();const existing=await db.select({id:favorites.id}).from(favorites).where(and(eq(favorites.organizationId,context.organization.id),eq(favorites.userId,context.user.id),eq(favorites.entityType,data.entityType),eq(favorites.entityId,data.entityId))).limit(1);if(existing[0])await db.delete(favorites).where(eq(favorites.id,existing[0].id));else await db.insert(favorites).values({organizationId:context.organization.id,userId:context.user.id,...data});revalidatePath("/workspace")})}
 export async function recordRecentlyViewed(input:unknown){return safe(async()=>{const data=z.object({entityType:z.string().min(1).max(40),entityId:z.string().min(1).max(100),title:z.string().min(1).max(160),href:z.string().startsWith("/workspace/").max(300)}).parse(input);const context=await requireWorkspaceContext();await database().insert(recentlyViewedItems).values({organizationId:context.organization.id,userId:context.user.id,...data}).onConflictDoUpdate({target:[recentlyViewedItems.organizationId,recentlyViewedItems.userId,recentlyViewedItems.entityType,recentlyViewedItems.entityId],set:{title:data.title,href:data.href,viewedAt:new Date()}})})}
-export async function updateOpportunityStage(input:unknown){return safe(async()=>{const data=z.object({id:uuid,stage:z.enum(["IDENTIFIED","QUALIFIED","NEGOTIATING","APPROVED","PILOT","ACTIVE","COMPLETED"])}).parse(input);const context=await requireWorkspaceContext();requirePermission(context.membership.role,"opportunity.update");const db=database();const changed=await db.update(opportunities).set({stage:data.stage,updatedAt:new Date()}).where(and(eq(opportunities.id,data.id),eq(opportunities.organizationId,context.organization.id))).returning({id:opportunities.id});if(!changed[0])throw new Error("Resource not found");await db.insert(opportunityStatusHistory).values({organizationId:context.organization.id,opportunityId:data.id,label:data.stage,detail:"Stage changed through the secure workspace mutation.",occurredAt:new Date(),actorId:context.user.id});await appendAuditLog({organizationId:context.organization.id,actorId:context.user.id,action:"opportunity.stage_changed",entityType:"opportunity",entityId:data.id,metadata:{stage:data.stage}});revalidatePath(`/workspace/opportunities/${data.id}`)})}
