 export async function recordPilotDecision(input:unknown){return safe(async()=>{const data=z.object({pilotId:uuid,decision:z.enum(["Scale","Continue","Revise","Pause","Close"]),reason:z.string().min(3).max(1000),evidence:z.string().min(3).max(1000),impact:z.string().min(3).max(1000),nextAction:z.string().min(3).max(1000)}).parse(input);const context=await requireWorkspaceContext();requirePermission(context.membership.role,"pilot.approve");const owned=await database().select({id:pilots.id}).from(pilots).where(and(eq(pilots.id,data.pilotId),eq(pilots.organizationId,context.organization.id))).limit(1);if(!owned[0])throw new Error("Resource not found");const [decision]=await database().insert(pilotDecisions).values({organizationId:context.organization.id,ownerId:context.user.id,...data}).returning({id:pilotDecisions.id});await appendAuditLog({organizationId:context.organization.id,actorId:context.user.id,action:"pilot.decision_recorded",entityType:"pilot_decision",entityId:decision.id,metadata:{pilotId:data.pilotId,decision:data.decision}});revalidatePath(`/workspace/pilots/${data.pilotId}`)})}
 
