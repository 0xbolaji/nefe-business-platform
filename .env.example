# PostgreSQL connection used by Drizzle and Auth.js persistence.
DATABASE_URL=postgresql://nefe:nefe@localhost:5432/nefe
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
NEFE_APP_URL=http://localhost:3000
# Development-only credential flow. Never enable in production.
NEFE_DEMO_AUTH_ENABLED=true
NEFE_DEMO_EMAIL=owner@nefe.local
NEFE_DEMO_PASSWORD=
# Transactional authentication email. Both values are required to send mail.
RESEND_API_KEY=
NEFE_EMAIL_FROM=
# Temporary rendering instrumentation. Enable only while capturing workspace lifecycle traces.
NEXT_PUBLIC_WORKSPACE_RENDER_DIAGNOSTICS=false
# Optional single OAuth provider.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
